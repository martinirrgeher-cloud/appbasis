{
  "name": "@appbasis/app-ulc-linz",
  "version": "0.0.0",
  "description": "ULC Linz generated AppBasis mini application.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.postgres-test.json",
    "test": "vitest run",
    "test:postgres": "vitest run --maxWorkers=1 ./test/lifecycle.postgres.e2e.test.ts ./test/lifecycle-persistence.postgres.e2e.test.ts ./test/lifecycle-audit.postgres.e2e.test.ts ./test/data-export.postgres.e2e.test.ts ./test/retention-claim.postgres.e2e.test.ts ./test/security-events.postgres.e2e.test.ts ./test/athletes-masterdata.postgres.e2e.test.ts ./test/athletes-restore-reconciliation.postgres.e2e.test.ts ./test/kindertraining.postgres.e2e.test.ts ./test/trainer-identity.postgres.e2e.test.ts ./test/exercise-catalog.postgres.e2e.test.ts"
  },
  "dependencies": {
    "@appbasis/athletes": "workspace:*",
    "@appbasis/countdown": "workspace:*",
    "@appbasis/exercise-catalog": "workspace:*",
    "@appbasis/training-blocks": "workspace:*",
    "@appbasis/database": "workspace:*",
    "@appbasis/identity": "workspace:*",
    "@appbasis/permissions": "workspace:*",
    "@appbasis/xlsx": "workspace:*",
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

{
  "name": "@appbasis/reference",
  "version": "0.0.0",
  "description": "AppBasis mobile-first reference application vertical slice.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo-bootstrap": "vite build --config tooling/vite.demo-orchestration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && node --test ./tooling/apply-reference-migrations.test.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "migrate:reference": "node ./tooling/apply-reference-migrations.mjs",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@appbasis/database": "workspace:*",
    "@appbasis/identity": "workspace:*",
    "@appbasis/permissions": "workspace:*",
    "hono": "4.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}

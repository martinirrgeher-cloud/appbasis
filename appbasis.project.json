{
  "schemaVersion": 1,
  "project": {
    "name": "AppBasis",
    "kind": "platform",
    "status": "phase-2a-foundation"
  },
  "toolchain": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "architecture": {
    "repository": "modular-monorepo",
    "connectivity": "resilient-online-first",
    "defaultOrganizationModel": "single-organization",
    "userExperience": "mobile-first-pwa",
    "coreUpdateModel": "versioned-controlled-updates"
  },
  "referenceApplication": {
    "path": "apps/reference",
    "status": "local-vertical-slice",
    "frontend": ["React", "Vite"],
    "backend": ["Cloudflare Worker", "Hono"],
    "healthEndpoint": "/api/health",
    "deployment": "not-configured",
    "database": "not-configured",
    "authentication": "not-configured"
  },
  "database": {
    "package": "packages/database",
    "dialect": "postgresql",
    "orm": "drizzle",
    "migrations": "versioned",
    "productionProvider": "not-configured",
    "localMigrationTests": "pglite"
  },
  "identity": {
    "package": "packages/identity",
    "publicLoginIdentifier": "username",
    "provider": "better-auth",
    "providerBoundary": "encapsulated",
    "publicRegistration": false,
    "realEmail": "optional-person-attribute",
    "technicalAuthEmail": "internal-only",
    "accountStatusAuthority": "auth-provider",
    "businessPermissions": "not-configured"
  }
}

{
  "name": "appbasis",
  "version": "0.0.0",
  "private": true,
  "description": "AppBasis platform and application factory",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "verify:toolchain": "node ./tooling/verify-toolchain.mjs",
    "verify:repo": "pnpm run verify:toolchain && pnpm run db:check && git diff --check",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @appbasis/database db:generate",
    "db:check": "pnpm --filter @appbasis/database db:check",
    "test:database": "pnpm --filter @appbasis/database test",
    "test:identity": "pnpm --filter @appbasis/identity test",
    "reference:dev": "pnpm --filter @appbasis/reference dev"
  }
}

{
  "name": "appbasis",
  "version": "0.0.0",
  "private": true,
  "description": "AppBasis platform and application factory",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "verify:toolchain": "node ./tooling/verify-toolchain.mjs",
    "verify:apps": "node --test ./tooling/app-definition.test.mjs ./tooling/create-app.test.mjs ./tooling/generated-database-manifest.test.mjs ./tooling/generated-runtime-template.test.mjs ./tooling/generated-worker-entrypoint-template.test.mjs ./tooling/factory-ui/factory-ui.test.mjs ./tooling/factory-ui/factory-ui-write-security.test.mjs ./tooling/factory-ui/preview-readiness.test.mjs && node --check ./tooling/factory-ui/app.js && node --check ./tooling/factory-ui/create-app.js && node ./tooling/verify-app-definitions.mjs",
    "verify:migrations": "node ./tooling/verify-migration-contract.mjs",
    "verify:preview-smoke": "node --check ./tooling/reference-preview-smoke.mjs",
    "verify:preview-deploy": "node --test ./tooling/reference-preview-deploy-config.test.mjs ./tooling/reference-preview-worker-settings.test.mjs ./tooling/reference-role-admin-ingress.test.mjs ./tooling/reference-role-admin-secret-bootstrap.test.mjs",
    "verify:generated-preview-deploy": "node --test ./tooling/generated-preview-deploy-config.test.mjs ./tooling/generated-tasks-preview-hyperdrive.test.mjs ./tooling/generated-preview-workflow-contract.test.mjs ./tooling/m3-preview-hyperdrive.test.mjs ./tooling/m3-preview-hyperdrive-bootstrap.test.mjs ./tooling/m3-preview-worker-bootstrap.test.mjs ./tooling/m3-preview-worker-bootstrap-workflow.test.mjs ./tooling/m3-preview-initial-version.test.mjs ./tooling/m3-preview-initial-version-workflow.test.mjs ./tooling/m3-preview-deployment-contract.test.mjs ./apps/m3-preview/tooling/bootstrap-root-admin.test.mjs ./apps/m3-preview/tooling/bootstrap-smoke-principals.test.mjs ./tooling/m3-preview-acceptance-smoke.test.mjs ./tooling/m3-preview-operational-workflow.test.mjs",
    "verify:generated-preview-smoke": "node --test ./tooling/generated-preview-smoke.test.mjs ./tooling/generated-preview-database-smoke.test.mjs && pnpm --filter @appbasis/app-tasks-minimal exec vitest run ./test/preview-worker.test.ts && pnpm --filter @appbasis/app-m3-preview exec vitest run ./test/preview-worker.test.ts",
    "verify:generated-preview-migrations": "node --test ./tooling/database-migration-executor.test.mjs ./apps/tasks-minimal/tooling/apply-generated-preview-migrations.test.mjs ./apps/m3-preview/tooling/verify-preview-schema.test.mjs ./tooling/generated-preview-migration-workflow-contract.test.mjs",
    "verify:repo": "pnpm run verify:toolchain && pnpm run verify:apps && pnpm run verify:migrations && pnpm run verify:preview-smoke && pnpm run verify:preview-deploy && pnpm run verify:generated-preview-deploy && pnpm run verify:generated-preview-smoke && pnpm run verify:generated-preview-migrations && pnpm run db:check && git diff --check",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @appbasis/identity db:generate",
    "db:check": "pnpm --filter @appbasis/identity db:check",
    "test:identity": "pnpm --filter @appbasis/identity test",
    "test:identity:e2e": "pnpm --filter @appbasis/identity test:e2e",
    "appbasis:create": "node ./tooling/create-app.mjs",
    "factory:dev": "node ./tooling/factory-ui/server.mjs",
    "reference:dev": "pnpm --filter @appbasis/reference dev",
    "reference:smoke": "node ./tooling/reference-preview-smoke.mjs"
  }
}

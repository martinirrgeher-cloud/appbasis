{
  "name": "@appbasis/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/access.ts",
    "./better-auth": "./src/better-auth.ts",
    "./http": "./src/http.ts",
    "./postgres-deletion": "./src/postgres-deletion.ts",
    "./postgres-deletion-retention": "./src/postgres-deletion-retention.ts",
    "./postgres-runtime": {
      "types": "./src/postgres-runtime-contract.ts",
      "default": "./src/postgres-runtime.ts"
    },
    "./root-admin": "./src/root-admin.ts",
    "./schema": "./src/schema/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate --name appbasis_identity_foundation",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@appbasis/database": "workspace:*",
    "@better-auth/drizzle-adapter": "1.6.27",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
